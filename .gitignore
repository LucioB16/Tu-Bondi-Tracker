## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono Auto Generated Files
mono_crash.*

# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/

# Visual Studio 2015 cache/options directory
.vs/

# Others
*.dbmdl
*.bak
*.cache
*.log

# Rider
.idea/
*.sln.iml

# Dotnet
project.lock.json
project.fragment.lock.json
artifacts/

# OS files
.DS_Store
Thumbs.db

# Paket dependency manager
.paket/
paket-files/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# Others
debug.log

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper

# Local History for Visual Studio
.localhistory/

# NCrunch
_NCrunch_*/
.*crunch*.local.xml

# Files built by Visual Studio
debug/
release/

# Coverage
*.coverage
*.coveragexml

# Node
node_modules/

# dotenv
.env

# Azure Functions
local.settings.json

# Visual Studio Code
.vscode/

